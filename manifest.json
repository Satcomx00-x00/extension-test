{
  "manifest_version": 3,
  "name": "Form Quiz Auto Answerer",
  "version": "1.0",
  "description": "Automatically answers Google Forms and Microsoft Forms quizzes using ChatGPT",
  "permissions": ["activeTab", "storage", "scripting"],
  "host_permissions": [
    "https://docs.google.com/forms/*",
    "https://forms.office.com/*",
    "https://forms.microsoft.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "images/icon16.png",
      "48": "images/icon48.png",
      "128": "images/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://docs.google.com/forms/*"],
      "js": ["content-scripts/google-forms.js"]
    },
    {
      "matches": ["https://forms.office.com/*", "https://forms.microsoft.com/*"],
      "js": ["content-scripts/microsoft-forms.js"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "images/icon16.png",
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  }
}
