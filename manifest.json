{
  "manifest_version": 3,
  "name": "Form Quiz Auto Answerer",
  "version": "1.0",
  "description": "Automatically answers quiz questions in Google Forms and Microsoft Forms using ChatGPT",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://docs.google.com/forms/*",
    "https://forms.office.com/*",
    "https://forms.microsoft.com/*",
    "https://chatgpt.com/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://docs.google.com/forms/*"],
      "js": ["content-scripts/google-forms.js"]
    },
    {
      "matches": ["https://forms.office.com/*", "https://forms.microsoft.com/*"],
      "js": ["content-scripts/microsoft-forms.js"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
